# Patch only an explicitly isolated, project-owned Hunter root.
if(NOT DEFINED ENV{HUNTER_ROOT} OR NOT EXISTS "$ENV{HUNTER_ROOT}/TELENO_ANDROID_OWNED")
  message(FATAL_ERROR "Use a dedicated Android HUNTER_ROOT containing TELENO_ANDROID_OWNED; never patch a shared cache")
endif()
file(GLOB _android_hunter_modules "$ENV{HUNTER_ROOT}/_Base/Download/Hunter/*/*/Unpacked/cmake/modules/hunter_dump_cmake_flags.cmake")
foreach(_android_module IN LISTS _android_hunter_modules)
  file(SHA256 "${_android_module}" _android_hash)
  if(_android_hash STREQUAL "66fc38e0d2b145a0a320e657f5c0fbd1afabe4b57f2b6c2818f62664af919daa")
    continue()
  endif()
  if(NOT _android_hash STREQUAL "eb9af922a2427a58232505ddd96640a90eab52732514cf1986f836a61aab7916")
    message(FATAL_ERROR "Unrecognized Hunter linker-flag helper; review before patching")
  endif()
  file(READ "${_android_module}" _android_text)
  set(_android_old [=[    foreach(x ${CMAKE_CXX_IMPLICIT_LINK_LIBRARIES})
      if(EXISTS "${x}")]=])
  set(_android_new [=[    foreach(x ${CMAKE_CXX_IMPLICIT_LINK_LIBRARIES})
      # Modern Android NDK/CMake may report GNU exact-name linker flags.
      # They already include -l; prepending it produces -l-l:libunwind.a.
      if(EXISTS "${x}" OR x MATCHES "^-l:")]=])
  string(REPLACE "${_android_old}" "${_android_new}" _android_text "${_android_text}")
  file(WRITE "${_android_module}" "${_android_text}")
  file(SHA256 "${_android_module}" _android_hash)
  if(NOT _android_hash STREQUAL "66fc38e0d2b145a0a320e657f5c0fbd1afabe4b57f2b6c2818f62664af919daa")
    message(FATAL_ERROR "Hunter Android patch did not produce the expected source")
  endif()
endforeach()
