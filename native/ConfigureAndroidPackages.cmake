# Only alter the FetchContent-owned Koinos CMake checkout, and only at the pin
# selected by native/dependencies/CMakeLists.txt. Never patch a user's SDK.
if(NOT DEFINED koinos_cmake_SOURCE_DIR)
  message(FATAL_ERROR "Koinos CMake source must be populated first")
endif()
set(_android_secp "${CMAKE_CURRENT_LIST_DIR}/vendor/secp256k1-vrf-android.tar.gz")
file(SHA256 "${_android_secp}" _android_secp_hash)
if(NOT _android_secp_hash STREQUAL "8f5e3c486152d57c13c8e483358d77725efef56fcc9091b33c37deaffb87ec66")
  message(FATAL_ERROR "Android secp256k1-vrf source archive does not match the reviewed build-only patch")
endif()
set(_android_koinos_config "${koinos_cmake_SOURCE_DIR}/Hunter/config.cmake")
file(READ "${_android_koinos_config}" _android_config)
set(_android_old "URL \"https://github.com/koinos/secp256k1-vrf/archive/db479e83be5685f652a9bafefaef77246fdf3bbe.tar.gz\"\n   SHA1 \"62df75e061c4afd6f0548f1e8267cc3da6abee15\"")
set(_android_new "URL \"file://${_android_secp}\"\n   SHA1 \"23f9075e566fc5ff60a3afc0ab34ebe3a2eafdc7\"")
string(FIND "${_android_config}" "${_android_old}" _android_original)
string(FIND "${_android_config}" "${_android_new}" _android_patched)
if(NOT _android_original EQUAL -1)
  string(REPLACE "${_android_old}" "${_android_new}" _android_config "${_android_config}")
  file(WRITE "${_android_koinos_config}" "${_android_config}")
elseif(_android_patched EQUAL -1)
  message(FATAL_ERROR "Unexpected Koinos CMake libsecp256k1-vrf recipe; refusing a blind replacement")
endif()

# Protobuf linkage and RocksDB Android-header fixes are separately pinned.
foreach(_android_dependency IN ITEMS protobuf rocksdb)
  set(_android_archive "${CMAKE_CURRENT_LIST_DIR}/vendor/${_android_dependency}-android.tar.gz")
  file(READ "${CMAKE_CURRENT_LIST_DIR}/vendor/${_android_dependency}-SOURCES.json" _android_meta)
  string(JSON _android_expected GET "${_android_meta}" patchedArchiveSha256)
  file(SHA256 "${_android_archive}" _android_actual)
  if(NOT _android_actual STREQUAL _android_expected)
    message(FATAL_ERROR "Android dependency overlay hash mismatch: ${_android_dependency}")
  endif()
  string(JSON _android_original_url GET "${_android_meta}" upstream)
  string(JSON _android_original_sha GET "${_android_meta}" upstreamSha1)
  string(JSON _android_overlay_sha GET "${_android_meta}" patchedArchiveSha1)
  file(READ "${_android_koinos_config}" _android_config)
  string(FIND "${_android_config}" "${_android_original_url}" _android_position)
  if(NOT _android_position EQUAL -1)
    string(REPLACE "${_android_original_url}" "file://${_android_archive}" _android_config "${_android_config}")
    string(REPLACE "${_android_original_sha}" "${_android_overlay_sha}" _android_config "${_android_config}")
    if(_android_dependency STREQUAL "protobuf")
      set(_android_package Protobuf)
    else()
      set(_android_package rocksdb)
    endif()
    string(REPLACE "hunter_config(${_android_package}\n" "hunter_config(${_android_package}\n   CONFIGURATION_TYPES Release\n" _android_config "${_android_config}")
    file(WRITE "${_android_koinos_config}" "${_android_config}")
  else()
    string(FIND "${_android_config}" "file://${_android_archive}" _android_position)
    if(_android_position EQUAL -1)
      message(FATAL_ERROR "Unrecognized ${_android_dependency} recipe")
    endif()
  endif()
endforeach()

# gRPC's target-side protoc plugins link libprotoc even during a cross-build.
# Keep those compiler libraries available; execute the separately built host
# protoc/grpc_cpp_plugin through PATH when generating messages.
file(READ "${_android_koinos_config}" _android_config)
if(NOT _android_config MATCHES "protobuf_BUILD_LIBPROTOC=ON")
  string(REGEX REPLACE "(hunter_config\\(Protobuf[^)]*CMAKE_ARGS)"
    "\\1\n      protobuf_BUILD_LIBPROTOC=ON" _android_config "${_android_config}")
endif()
if(NOT _android_config MATCHES "hunter_config\\(gRPC\n   CONFIGURATION_TYPES Release")
  string(REPLACE "hunter_config(gRPC\n" "hunter_config(gRPC\n   CONFIGURATION_TYPES Release\n"
    _android_config "${_android_config}")
endif()
file(WRITE "${_android_koinos_config}" "${_android_config}")
