if(NOT EXISTS "$ENV{TELENO_ANDROID_NDK}/source.properties")
  message(FATAL_ERROR "Set TELENO_ANDROID_NDK to the Android NDK r27d directory")
endif()
file(READ "$ENV{TELENO_ANDROID_NDK}/source.properties" _teleno_ndk_identity)
if(NOT _teleno_ndk_identity MATCHES "Pkg.Revision = 27\\.3\\.13750724")
  message(FATAL_ERROR "The current Teleno Android port is pinned to NDK r27d (27.3.13750724)")
endif()
set(ANDROID_ABI arm64-v8a CACHE STRING "" FORCE)
set(ANDROID_PLATFORM android-28 CACHE STRING "" FORCE)
set(ANDROID_STL c++_static CACHE STRING "" FORCE)
set(ANDROID_SUPPORT_FLEXIBLE_PAGE_SIZES ON CACHE BOOL "" FORCE)
include("$ENV{TELENO_ANDROID_NDK}/build/cmake/android.toolchain.cmake")
