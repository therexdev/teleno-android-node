diff --git a/src/storage/lite_state.hpp b/src/storage/lite_state.hpp
new file mode 100644
index 0000000..9af8ae8
--- /dev/null
+++ b/src/storage/lite_state.hpp
@@ -0,0 +1,27 @@
+#pragma once
+#include <map>
+#include <mutex>
+#include <stdexcept>
+#include <rocksdb/db.h>
+
+namespace koinos::node::storage {
+// The storage owner registers its existing durable-state handle. This adds no
+// fields to the public BlockStore/NodeConfig layouts, including for relinking.
+inline std::mutex lite_state_mutex;
+inline std::map<rocksdb::DB*, rocksdb::ColumnFamilyHandle*> lite_state_handles;
+inline void register_lite_state(rocksdb::DB* db, rocksdb::ColumnFamilyHandle* state) {
+  std::lock_guard lock(lite_state_mutex);lite_state_handles[db]=state;
+}
+inline void unregister_lite_state(rocksdb::DB* db) {
+  std::lock_guard lock(lite_state_mutex);lite_state_handles.erase(db);
+}
+inline uint64_t lite_durable_revision(rocksdb::DB* db) {
+  std::lock_guard lock(lite_state_mutex);
+  auto found=lite_state_handles.find(db);
+  if(found==lite_state_handles.end())throw std::runtime_error("Lite durable state handle unavailable");
+  std::string revision;auto status=db->Get({},found->second,"revision",&revision);
+  if(!status.ok() || revision.size()!=8)throw std::runtime_error("Lite durable revision unavailable");
+  uint64_t height=0;for(unsigned char b:revision)height=(height<<8)|b;
+  return height;
+}
+}
