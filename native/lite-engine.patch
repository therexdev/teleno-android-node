+void check(bool ok,const char* why){if(!ok)throw std::runtime_error(why);}
+template<typename F>void rejects(F action,const char* why){bool failed=false;try{action();}catch(const std::exception&){failed=true;}check(failed,why);}
+std::string id(uint64_t height,char branch='a'){
+  std::string result="\x12\x20";result+=std::string(24,branch);
+  for(int shift=56;shift>=0;shift-=8)result.push_back(static_cast<char>(height>>shift));return result;
+}
+rpc::block_store::add_block_request request(uint64_t height,char branch='a'){
+  rpc::block_store::add_block_request r;auto* b=r.mutable_block_to_add();b->set_id(id(height,branch));
+  b->mutable_header()->set_height(height);b->mutable_header()->set_previous(id(height-1));
+  b->set_signature(std::string(256,'s'));r.mutable_receipt_to_add()->set_id(b->id());r.mutable_receipt_to_add()->set_height(height);return r;
+}
+struct Fixture{
+  fs::path path;storage::RocksDBManager manager;std::unique_ptr<node::block_store::BlockStore> store;
+  Fixture():path(fs::temp_directory_path()/ ("teleno-lite-retention-"+std::to_string(std::random_device{}()))){open();}
+  void open(){NodeConfig cfg;cfg.rocksdb_block_cache_mb=8;cfg.rocksdb_compression="none";manager.open(path,cfg);
+    store=std::make_unique<node::block_store::BlockStore>(manager.db(),manager.handle(storage::ColumnFamily::blocks),manager.handle(storage::ColumnFamily::block_meta));store->initialize();}
+  void close(){store.reset();manager.close();}
+  ~Fixture(){close();fs::remove_all(path);}
+  bool contains(uint64_t h,char branch='a'){
+    rpc::block_store::get_blocks_by_id_request r;r.add_block_ids(id(h,branch));r.set_return_block(true);r.set_return_receipt(true);
+    return store->get_blocks_by_id(r).block_items_size()==1;
+  }
+};
+void rolling_and_restart(){
+  Fixture f;f.store->enable_lite(64);
+  auto state=f.manager.handle(storage::ColumnFamily::chain_state);auto meta=f.manager.handle(storage::ColumnFamily::chain_metadata);
+  check(f.manager.db()->Put({},state,"unchanged","current consensus state").ok(),"state fixture write");
+  check(f.manager.db()->Put({},meta,"merkle_root","unchanged root").ok(),"root fixture write");
+  for(uint64_t h=1;h<=512;++h){f.store->add_block(request(h));if(h>10)f.store->advance_lite_finality(h-10);}
+  check(f.store->retained_from()==438,"finality determines retention boundary");
+  check(!f.contains(437)&&f.contains(438)&&f.contains(512),"old records removed; all needed recent records retained");
+  for(uint64_t h=438;h<=512;++h){
+    rpc::block_store::get_blocks_by_height_request r;r.set_head_block_id(id(512));r.set_ancestor_start_height(h);r.set_num_blocks(1);r.set_return_block(true);
+    auto result=f.store->get_blocks_by_height(r);check(result.block_items_size()==1&&result.block_items(0).block_height()==h,"ancestor lookup across power-of-two boundaries after pruning");
+  }
+  rpc::block_store::get_blocks_by_height_request old;old.set_head_block_id(id(512));old.set_ancestor_start_height(1);old.set_num_blocks(1);old.set_return_block(true);
+  check(f.store->get_blocks_by_height(old).block_items_size()==0,"unavailable history is an empty response");
+  rejects([&]{f.store->add_block(request(1));},"old body cannot grow back after pruning");
+  const auto floor=f.store->retained_from();f.store->advance_lite_finality(100);check(f.store->retained_from()==floor,"finality regression never removes additional data");
+  rejects([&]{f.store->advance_lite_finality(9000);},"finality above stored head rejected");
+  std::string value;check(f.manager.db()->Get({},state,"unchanged",&value).ok()&&value=="current consensus state","pruning preserves state bytes");
+  check(f.manager.db()->Get({},meta,"merkle_root",&value).ok()&&value=="unchanged root","pruning preserves root bytes");
+  f.close();f.open();check(f.store->retained_from()==438,"floor persists across restart before enabling services");f.store->enable_lite(64);
+  f.store->add_block(request(513));check(f.contains(513),"new block stores after restart");
+  f.store->add_block(request(512,'b'));check(f.contains(512,'b'),"recent fork is retained");
