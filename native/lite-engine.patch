+std::string BlockStore::height_key( uint64_t height, const std::string& id )
+{
+  std::string key=LITE_HEIGHT_PREFIX;
+  for( int shift=56; shift>=0; shift-=8 ) key.push_back(static_cast<char>(height>>shift));
+  return key+id;
+}
+
+BlockStore::LitePolicy BlockStore::read_lite_policy() const
+{
+  std::string floor_text, window_text;
+  auto status=_db->Get({},_cf_meta,LITE_FLOOR_KEY,&floor_text);
+  auto window_status=_db->Get({},_cf_meta,"lite.retention_blocks",&window_text);
+  if(status.IsNotFound() && window_status.IsNotFound())return {};
+  if(!status.ok() || !window_status.ok())throw std::runtime_error("incomplete or unreadable Lite retention policy");
+  LitePolicy policy;
+  auto number=[](const std::string& text,uint64_t& value) {
+    const auto parsed=std::from_chars(text.data(),text.data()+text.size(),value);
+    return parsed.ec==std::errc{} && parsed.ptr==text.data()+text.size();
+  };
+  if(!number(floor_text,policy.floor) || !number(window_text,policy.window)
+     || !policy.floor || policy.window<64 || policy.window>1000000)
+    throw std::runtime_error("invalid persisted Lite retention policy");
+  return policy;
+}
+
+uint64_t BlockStore::retained_from() const
+{
+  std::shared_lock lock(_mutex);return read_lite_policy().floor;
+}
+
+void BlockStore::enable_lite( uint64_t retained_blocks )
+{
+  if(retained_blocks<64 || retained_blocks>1000000)throw std::invalid_argument("Lite retained blocks must be between 64 and 1000000");
+  std::unique_lock lock(_mutex);koinos::block_topology highest;
+  if(!get_highest_block_topology(highest))throw std::runtime_error("initialize block store before enabling Lite mode");
+  const auto policy=read_lite_policy();
+  if(policy.floor)
+  {
+    if(policy.window!=retained_blocks)throw std::runtime_error("Lite retention changes require a separate snapshot export");
+    return;
+  }
+  if(highest.height()!=0)throw std::runtime_error("existing archive requires a separate compact export; automatic destructive conversion is disabled");
+  rocksdb::WriteBatch batch;
+  auto status=batch.Put(_cf_meta,LITE_FLOOR_KEY,"1");if(!status.ok())throw std::runtime_error(status.ToString());
+  status=batch.Put(_cf_meta,"lite.retention_blocks",std::to_string(retained_blocks));if(!status.ok())throw std::runtime_error(status.ToString());
+  rocksdb::WriteOptions writes;writes.sync=true;
+  status=_db->Write(writes,&batch);if(!status.ok())throw std::runtime_error(status.ToString());
+}
+
+void BlockStore::advance_lite_finality( uint64_t durable_finalized_height )
+{
+  std::unique_lock lock(_mutex);
+  const auto policy=read_lite_policy();
+  if(!policy.window || durable_finalized_height<=policy.window)return;
+  koinos::block_topology highest;
+  if(!get_highest_block_topology(highest) || durable_finalized_height>highest.height())
+    throw std::runtime_error("Lite finality exceeds archived head");
+  const uint64_t target=durable_finalized_height-policy.window;
+  if(target<=policy.floor)return;
+  // Read by the post-accept callback from already committed state metadata.
+  // The finality argument is never supplied by a public RPC client.
+  // Bound ordinary catch-up to 128 heights per atomic pruning transaction.
+  const uint64_t next=std::min(target,policy.floor+128);
+  rocksdb::ReadOptions reads;reads.verify_checksums=true;reads.fill_cache=false;
+  std::unique_ptr<rocksdb::Iterator> it(_db->NewIterator(reads,_cf_meta));
+  rocksdb::WriteBatch batch;
+  for(it->Seek(height_key(policy.floor));it->Valid()&&it->key().starts_with(LITE_HEIGHT_PREFIX);it->Next())
+  {
+    const std::string key=it->key().ToString();
+    if(key.size()!=LITE_HEIGHT_PREFIX.size()+8+34)throw std::runtime_error("invalid Lite height index key");
+    uint64_t height=0;for(size_t i=LITE_HEIGHT_PREFIX.size();i<LITE_HEIGHT_PREFIX.size()+8;++i)height=(height<<8)|static_cast<unsigned char>(key[i]);
+    if(height>=next)break;
+    const std::string id=it->value().ToString();
+    if(id.size()!=34 || key.substr(LITE_HEIGHT_PREFIX.size()+8)!=id)throw std::runtime_error("invalid Lite height index identity");
+    koinos::block_store::block_record record;
+    if(!record.ParseFromString(get_record_bytes(id)) || record.block_id()!=id || record.block_height()!=height)
+      throw std::runtime_error("Lite height index does not match its block");
+    auto status=batch.Delete(_cf_blocks,id);if(!status.ok())throw std::runtime_error(status.ToString());
+    status=batch.Delete(_cf_meta,key);if(!status.ok())throw std::runtime_error(status.ToString());
+  }
+  if(!it->status().ok())throw std::runtime_error(it->status().ToString());
+  auto status=batch.Put(_cf_meta,LITE_FLOOR_KEY,std::to_string(next));if(!status.ok())throw std::runtime_error(status.ToString());
+  rocksdb::WriteOptions writes;writes.sync=true;
+  status=_db->Write(writes,&batch);if(!status.ok())throw std::runtime_error(status.ToString());
+}
