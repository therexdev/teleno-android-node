# Preserve Teleno's compatibility aliases, then map soralog's hard-coded
# desktop libpthread dependency to CMake's actual Android thread target.
if(NOT TELENO_ANDROID_TELENO_SOURCE)
  message(FATAL_ERROR "Set TELENO_ANDROID_TELENO_SOURCE to the prepared Teleno source")
endif()
include("${TELENO_ANDROID_TELENO_SOURCE}/cmake/cpp-libp2p-koinos-prelude.cmake")
if(ANDROID)
  find_package(Threads REQUIRED)
  find_package(fmt CONFIG REQUIRED)
  find_package(soralog CONFIG REQUIRED)
  foreach(_target soralog::sink_to_console soralog::sink_to_file soralog::sink_to_syslog)
    if(NOT TARGET ${_target})
      message(FATAL_ERROR "Unexpected pinned soralog target: ${_target}")
    endif()
    get_target_property(_links ${_target} INTERFACE_LINK_LIBRARIES)
    list(TRANSFORM _links REPLACE "^pthread$" "Threads::Threads")
    set_property(TARGET ${_target} PROPERTY INTERFACE_LINK_LIBRARIES "${_links}")
  endforeach()
endif()
