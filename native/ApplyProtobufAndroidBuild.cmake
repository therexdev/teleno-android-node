# Apply only the recorded Android CMake linkage fix after Teleno has applied
# and verified its original protobuf ownership patch. No C++ files are touched.
if(NOT ANDROID)
  return()
endif()
if(NOT DEFINED TELENO_ANDROID_PROTOBUF_SOURCE)
  message(FATAL_ERROR "Missing isolated protobuf source path")
endif()
set(_android_proto_files
  "cmake/libprotobuf.cmake|4dee60a0125ab66dc513fed5e4de265c5d8d86d96d632614efb1d1118fa5444c|9acea0f6bfb6aa5d8229430f34ae73f3153c950c70a68d2583d07b8999cea79c"
  "cmake/libprotobuf-lite.cmake|22cbe4361c87e10b688a3a5b434f6fdd63459613d4007fcd1ba15638c9ff91f3|e4d80cd38b87a85e9dac16cf5d74d40486471fee397692350db717453b203704"
  "cmake/protobuf-config.cmake.in|5172e3799480c395a23f11a44edc4e810ecb89afca90a626fcf4a83246708a28|fb7fe8a4319b582e8088c07f11f2034f69e310ac313a3ba3dcdc0a4fe6d76a0b"
 )
set(_android_proto_needs_patch FALSE)
set(_android_proto_already_patch FALSE)
foreach(_row IN LISTS _android_proto_files)
  string(REPLACE "|" ";" _columns "${_row}")
  list(GET _columns 0 _name)
  list(GET _columns 1 _before)
  list(GET _columns 2 _after)
  file(SHA256 "${TELENO_ANDROID_PROTOBUF_SOURCE}/${_name}" _actual)
  if(_actual STREQUAL _before)
    set(_android_proto_needs_patch TRUE)
  elseif(_actual STREQUAL _after)
    set(_android_proto_already_patch TRUE)
  else()
    message(FATAL_ERROR "Unexpected protobuf CMake input: ${_name}")
  endif()
endforeach()
if(_android_proto_needs_patch AND _android_proto_already_patch)
  message(FATAL_ERROR "Partial protobuf Android CMake patch; use a fresh isolated source")
endif()
if(_android_proto_needs_patch)
  find_program(TELENO_ANDROID_PATCH patch REQUIRED)
  set(_patch "${CMAKE_CURRENT_LIST_DIR}/patches/protobuf-android-build.patch")
  file(SHA256 "${_patch}" _hash)
  if(NOT _hash STREQUAL "6025fab1261d1bb308defdbeae39e0e676b2c72aab1f3b57f96e42a34bb5fd44")
    message(FATAL_ERROR "Android protobuf build patch hash mismatch")
  endif()
  execute_process(COMMAND "${TELENO_ANDROID_PATCH}" --batch --forward -p1 -i "${_patch}"
    WORKING_DIRECTORY "${TELENO_ANDROID_PROTOBUF_SOURCE}" RESULT_VARIABLE _result)
  if(NOT _result EQUAL 0)
    message(FATAL_ERROR "Android protobuf CMake patch failed")
  endif()
endif()
foreach(_row IN LISTS _android_proto_files)
  string(REPLACE "|" ";" _columns "${_row}")
  list(GET _columns 0 _name)
  list(GET _columns 2 _expected)
  file(SHA256 "${TELENO_ANDROID_PROTOBUF_SOURCE}/${_name}" _actual)
  if(NOT _actual STREQUAL _expected)
    message(FATAL_ERROR "Android protobuf CMake output mismatch: ${_name}")
  endif()
endforeach()
